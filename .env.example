# Local server configuration
PORT=3000

# Local Kafka defaults. Override KAFKA_BROKER for another environment.
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=message-triage-dashboard
KAFKA_CONSUMER_GROUP_ID=message-triage-dashboard-group

# Preferred compact topic configuration.
KAFKA_TOPICS=intake,structured,cleared,ready,support,finance,website,outflow,review,sales

# TOPIC_1 through TOPIC_10 remain supported for compatibility with the original
# localhost .env file, but KAFKA_TOPICS takes precedence when it is set.
